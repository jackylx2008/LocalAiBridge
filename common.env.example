# Copy this file to common.env and fill in machine-local values.
LOG_LEVEL=INFO
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive/
CLOUDSTATION_ROOT_LINUX=~/CloudStation

LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_HOST=0.0.0.0
LLAMACPP_PORT=8080
LLAMACPP_MODEL=local-model
LLAMACPP_API_KEY=replace-with-a-long-random-secret
LLAMACPP_AUTOSTART=true
LLAMACPP_SERVER_PATH=
LLAMACPP_MODEL_PATH=
LLAMACPP_MMPROJ_PATH=
# Shared by projects under the same Python/Project directory.
LLAMACPP_EXTRA_DLL_DIRS=../vendor/cuda12
LLAMACPP_N_GPU_LAYERS=999
LLAMACPP_CTX_SIZE=8192
LLAMACPP_REASONING=off
LLAMACPP_REASONING_BUDGET=0
LLAMACPP_STARTUP_TIMEOUT=600
